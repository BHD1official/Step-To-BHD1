{"ast":null,"code":"import { IonText, IonButton } from \"@ionic/vue\";\nimport allQuestions from \"@/json/games/trivia.json\";\nimport { mapState, mapActions } from \"vuex\";\nexport default {\n  name: \"TriviaQuestions\",\n  props: [\"type\", \"noWrong\", \"stage\", \"noCorrect\", \"exam\"],\n  components: {\n    IonText,\n    IonButton\n  },\n  data() {\n    return {\n      questions: [],\n      nofQuestions: 0,\n      answered: false,\n      allAnswered: false,\n      numOfAnswered: 0\n    };\n  },\n  computed: {\n    ...mapState(\"games\", [\"chosenChapters\", \"testAnswers\", \"_questNum\"])\n  },\n  async beforeMount() {\n    if (this.type != 3) {\n      // trivia\n      allQuestions.forEach((chap, i) => {\n        chap.forEach(ques => {\n          ques.answered = false;\n          if (this.chosenChapters.includes(i)) {\n            this.questions.push(this.mixAns({\n              ...ques\n            }));\n          }\n        });\n      });\n      this.nofQuestions = this.questions.length;\n      this.updatequestNum(this.getNext());\n    } else {\n      // test (type == 3) - שאיבת שאלות מתוך הפרקים הנבחרים בלבד\n      let pool = [];\n      allQuestions.forEach((chap, i) => {\n        chap.forEach(ques => {\n          if (this.chosenChapters.includes(i)) {\n            pool.push(this.mixAns({\n              ...ques\n            }));\n          }\n        });\n      });\n\n      // ערבוב המאגר ולקיחת עד 10 שאלות למבחן הנוכחי\n      pool.sort(() => Math.random() - 0.5);\n      this.questions = pool.slice(0, 10);\n      let correct = [];\n      this.questions.forEach(ques => {\n        correct.push(ques.correct);\n      });\n      this.updateCorrectAns(correct);\n      this.nofQuestions = this.questions.length;\n      // תיקון קריטי: במבחן תמיד מביאים את המשתמש לשאלה ראשונה (אינדקס 0)\n      this.updatequestNum(0);\n    }\n  },\n  methods: {\n    ...mapActions(\"games\", [\"updateCorrectAns\", \"updatePickedAns\", \"nextQuestNum\", \"updatequestNum\", \"resetPicked\"]),\n    mixAns(ques) {\n      let min = 1,\n        max = 4;\n      let i = Math.round(Math.random() * (max - min) + min);\n      let j, k;\n      do j = Math.round(Math.random() * (max - min) + min); while (i == j);\n      do k = Math.round(Math.random() * (max - min) + min); while (k == j || k == i);\n      let tmp = ques[i];\n      ques[i] = ques[j];\n      ques[j] = ques[k];\n      ques[k] = tmp;\n      if (i == ques.correct) ques.correct = k;else if (j == ques.correct) ques.correct = i;else if (k == ques.correct) ques.correct = j;\n      return ques;\n    },\n    answerClass(n) {\n      if (this.stage == \"game\") return this.testAnswers[this._questNum] && this.testAnswers[this._questNum].picked == n ? \"picked\" : \"unpicked\";\n      let picked = this.testAnswers[this._questNum].picked;\n      let correct = this.testAnswers[this._questNum].correct;\n      if (n == picked) {\n        return picked == correct ? \"correct\" : \"wrong\";\n      }\n      if (n == correct) return \"correct\";\n    },\n    getNext() {\n      if (this.type != 3) {\n        let next;\n        do {\n          next = Math.floor(Math.random() * (this.nofQuestions - 0));\n        } while (this.questions[next].answered);\n        return next;\n      }\n      return this._questNum != this.testAnswers.length - 1 ? this._questNum + 1 : this._questNum;\n    },\n    reset() {\n      this.answered = false;\n      if (this.type != 3) {\n        this.questions.forEach(ques => {\n          ques.answered = false;\n          ques = this.mixAns({\n            ...ques\n          });\n        });\n        this.updatequestNum(this.getNext());\n      } else {\n        let pool = [];\n        allQuestions.forEach((chap, i) => {\n          chap.forEach(ques => {\n            if (this.chosenChapters.includes(i)) {\n              pool.push(this.mixAns({\n                ...ques\n              }));\n            }\n          });\n        });\n        pool.sort(() => Math.random() - 0.5);\n        this.questions = pool.slice(0, 10);\n        let correct = [];\n        this.questions.forEach(ques => {\n          correct.push(ques.correct);\n        });\n        this.updateCorrectAns(correct);\n        this.updatequestNum(0);\n      }\n      this.allAnswered = false;\n      this.numOfAnswered = 0;\n      this.$emit(\"EndGame\");\n    },\n    ansPicked(hisAnswer) {\n      this.type != 3 ? this.ansPickedGame(hisAnswer) : this.ansPickedTest(hisAnswer);\n    },\n    ansPickedGame(hisAnswer) {\n      let correct = this.questions[this._questNum].correct;\n      let timeout = 1500;\n      this.answered = true;\n      this.$refs[\"ans\" + hisAnswer][0].style.backgroundColor = \"var(--ion-color-danger)\";\n      this.$refs[\"ans\" + correct][0].style.backgroundColor = \"var(--ion-color-success)\";\n      if (hisAnswer == correct) {\n        this.questions[this._questNum].answered = true;\n        this.$emit(\"correct\", 1);\n      } else {\n        this.$emit(\"wrong\", 1);\n      }\n      setTimeout(() => {\n        if (this.type == 4 && this.noWrong == 3 || this.noCorrect == this.nofQuestions) {\n          this.reset();\n          return;\n        }\n        this.updatequestNum(this.getNext());\n        this.answered = false;\n        this.$refs[\"ans\" + hisAnswer][0].style.backgroundColor = \"var(--ion-color-tertiary)\";\n        this.$refs[\"ans\" + correct][0].style.backgroundColor = \"var(--ion-color-tertiary)\";\n      }, timeout);\n    },\n    ansPickedTest(hisAnswer) {\n      let picked = this.testAnswers[this._questNum].picked;\n      let correct = this.questions[this._questNum].correct;\n      let timeout = 700;\n      this.answered = true;\n      if (picked == -1) this.numOfAnswered++;\n      this.updatePickedAns({\n        _questNum: this._questNum,\n        hisAnswer: hisAnswer\n      });\n      if (hisAnswer == correct) {\n        if (picked != -1) this.$emit(\"wrong\", -1);\n        this.$emit(\"correct\", 1);\n      } else {\n        if (picked != -1) this.$emit(\"correct\", -1);\n        this.$emit(\"wrong\", 1);\n      }\n      if (this.numOfAnswered == this.nofQuestions) this.allAnswered = true;\n      setTimeout(() => {\n        if (picked == -1) this.updatequestNum(this.getNext());\n        this.answered = false;\n      }, timeout);\n    }\n  }\n};","map":{"version":3,"names":["IonText","IonButton","allQuestions","mapState","mapActions","name","props","components","data","questions","nofQuestions","answered","allAnswered","numOfAnswered","computed","beforeMount","type","forEach","chap","i","ques","chosenChapters","includes","push","mixAns","length","updatequestNum","getNext","pool","sort","Math","random","slice","correct","updateCorrectAns","methods","min","max","round","j","k","tmp","answerClass","n","stage","testAnswers","_questNum","picked","next","floor","reset","$emit","ansPicked","hisAnswer","ansPickedGame","ansPickedTest","timeout","$refs","style","backgroundColor","setTimeout","noWrong","noCorrect","updatePickedAns"],"sources":["C:\\Users\\User\\Step-To-BHD1\\src\\components\\home\\SubMenu\\SubMenu3\\Games\\Trivia\\TriviaQuestions.vue"],"sourcesContent":["<template>\r\n  <transition appear name=\"fadeA\">\r\n    <div class=\"ques\" v-if=\"stage == 'game' || stage == 'review'\">\r\n      <div class=\"ques-part\" :key=\"0\">\r\n        <div class=\"ques-card\">\r\n          <ion-text class=\"text-dark-plain\" v-model=\"_questNum\">\r\n            {{ questions[_questNum].ques }}</ion-text\r\n          >\r\n        </div>\r\n        <div class=\"line\"></div>\r\n      </div>\r\n\r\n      <div class=\"answers\">\r\n        <button\r\n          :disabled=\"answered || stage != 'game'\"\r\n          :class=\"['ans', answerClass(n)]\"\r\n          v-for=\"n in 4\"\r\n          :key=\"n\"\r\n          @click=\"ansPicked(n)\"\r\n          :ref=\"'ans' + n\"\r\n        >\r\n          <ion-text\r\n            class=\"text-dark-plain\"\r\n            :ref=\"`quest${n}`\"\r\n            v-model=\"_questNum\"\r\n          >\r\n            {{ questions[_questNum][n] }}</ion-text\r\n          >\r\n        </button>\r\n      </div>\r\n\r\n      <ion-button\r\n        shape=\"round\"\r\n        size=\"large\"\r\n        v-if=\"type == 3\"\r\n        :class=\"[allAnswered || stage == 'review' ? '' : 'transparent']\"\r\n        @click=\"reset\"\r\n        :key=\"0\"\r\n        >סיימתי</ion-button\r\n      >\r\n    </div>\r\n  </transition>\r\n</template>\r\n\r\n<script>\r\nimport { IonText, IonButton } from \"@ionic/vue\";\r\nimport allQuestions from \"@/json/games/trivia.json\";\r\nimport { mapState, mapActions } from \"vuex\";\r\n\r\nexport default {\r\n  name: \"TriviaQuestions\",\r\n  props: [\"type\", \"noWrong\", \"stage\", \"noCorrect\", \"exam\"],\r\n  components: { IonText, IonButton },\r\n\r\n  data() {\r\n    return {\r\n      questions: [],\r\n      nofQuestions: 0,\r\n      answered: false,\r\n      allAnswered: false,\r\n      numOfAnswered: 0,\r\n    };\r\n  },\r\n\r\n  computed: {\r\n    ...mapState(\"games\", [\"chosenChapters\", \"testAnswers\", \"_questNum\"]),\r\n  },\r\n\r\n  async beforeMount() {\r\n    if (this.type != 3) {\r\n      // trivia\r\n      allQuestions.forEach((chap, i) => {\r\n        chap.forEach((ques) => {\r\n          ques.answered = false;\r\n          if (this.chosenChapters.includes(i)) {\r\n            this.questions.push(this.mixAns({ ...ques }));\r\n          }\r\n        });\r\n      });\r\n      this.nofQuestions = this.questions.length;\r\n      this.updatequestNum(this.getNext());\r\n    } else {\r\n      // test (type == 3) - שאיבת שאלות מתוך הפרקים הנבחרים בלבד\r\n      let pool = [];\r\n      allQuestions.forEach((chap, i) => {\r\n        chap.forEach((ques) => {\r\n          if (this.chosenChapters.includes(i)) {\r\n            pool.push(this.mixAns({ ...ques }));\r\n          }\r\n        });\r\n      });\r\n\r\n      // ערבוב המאגר ולקיחת עד 10 שאלות למבחן הנוכחי\r\n      pool.sort(() => Math.random() - 0.5);\r\n      this.questions = pool.slice(0, 10);\r\n\r\n      let correct = [];\r\n      this.questions.forEach((ques) => {\r\n        correct.push(ques.correct);\r\n      });\r\n      this.updateCorrectAns(correct);\r\n\r\n      this.nofQuestions = this.questions.length;\r\n      // תיקון קריטי: במבחן תמיד מביאים את המשתמש לשאלה ראשונה (אינדקס 0)\r\n      this.updatequestNum(0);\r\n    }\r\n  },\r\n\r\n  methods: {\r\n    ...mapActions(\"games\", [\r\n      \"updateCorrectAns\",\r\n      \"updatePickedAns\",\r\n      \"nextQuestNum\",\r\n      \"updatequestNum\",\r\n      \"resetPicked\",\r\n    ]),\r\n\r\n    mixAns(ques) {\r\n      let min = 1,\r\n        max = 4;\r\n      let i = Math.round(Math.random() * (max - min) + min);\r\n      let j, k;\r\n\r\n      do j = Math.round(Math.random() * (max - min) + min);\r\n      while (i == j);\r\n\r\n      do k = Math.round(Math.random() * (max - min) + min);\r\n      while (k == j || k == i);\r\n\r\n      let tmp = ques[i];\r\n      ques[i] = ques[j];\r\n      ques[j] = ques[k];\r\n      ques[k] = tmp;\r\n\r\n      if (i == ques.correct) ques.correct = k;\r\n      else if (j == ques.correct) ques.correct = i;\r\n      else if (k == ques.correct) ques.correct = j;\r\n\r\n      return ques;\r\n    },\r\n\r\n    answerClass(n) {\r\n      if (this.stage == \"game\")\r\n        return this.testAnswers[this._questNum] &&\r\n          this.testAnswers[this._questNum].picked == n\r\n          ? \"picked\"\r\n          : \"unpicked\";\r\n\r\n      let picked = this.testAnswers[this._questNum].picked;\r\n      let correct = this.testAnswers[this._questNum].correct;\r\n\r\n      if (n == picked) {\r\n        return picked == correct ? \"correct\" : \"wrong\";\r\n      }\r\n      if (n == correct) return \"correct\";\r\n    },\r\n\r\n    getNext() {\r\n      if (this.type != 3) {\r\n        let next;\r\n        do {\r\n          next = Math.floor(Math.random() * (this.nofQuestions - 0));\r\n        } while (this.questions[next].answered);\r\n        return next;\r\n      }\r\n\r\n      return this._questNum != this.testAnswers.length - 1\r\n        ? this._questNum + 1\r\n        : this._questNum;\r\n    },\r\n\r\n    reset() {\r\n      this.answered = false;\r\n\r\n      if (this.type != 3) {\r\n        this.questions.forEach((ques) => {\r\n          ques.answered = false;\r\n          ques = this.mixAns({ ...ques });\r\n        });\r\n        this.updatequestNum(this.getNext());\r\n      } else {\r\n        let pool = [];\r\n        allQuestions.forEach((chap, i) => {\r\n          chap.forEach((ques) => {\r\n            if (this.chosenChapters.includes(i)) {\r\n              pool.push(this.mixAns({ ...ques }));\r\n            }\r\n          });\r\n        });\r\n        pool.sort(() => Math.random() - 0.5);\r\n        this.questions = pool.slice(0, 10);\r\n\r\n        let correct = [];\r\n        this.questions.forEach((ques) => {\r\n          correct.push(ques.correct);\r\n        });\r\n\r\n        this.updateCorrectAns(correct);\r\n        this.updatequestNum(0);\r\n      }\r\n\r\n      this.allAnswered = false;\r\n      this.numOfAnswered = 0;\r\n      this.$emit(\"EndGame\");\r\n    },\r\n\r\n    ansPicked(hisAnswer) {\r\n      this.type != 3\r\n        ? this.ansPickedGame(hisAnswer)\r\n        : this.ansPickedTest(hisAnswer);\r\n    },\r\n\r\n    ansPickedGame(hisAnswer) {\r\n      let correct = this.questions[this._questNum].correct;\r\n      let timeout = 1500;\r\n      this.answered = true;\r\n\r\n      this.$refs[\"ans\" + hisAnswer][0].style.backgroundColor =\r\n        \"var(--ion-color-danger)\";\r\n      this.$refs[\"ans\" + correct][0].style.backgroundColor =\r\n        \"var(--ion-color-success)\";\r\n\r\n      if (hisAnswer == correct) {\r\n        this.questions[this._questNum].answered = true;\r\n        this.$emit(\"correct\", 1);\r\n      } else {\r\n        this.$emit(\"wrong\", 1);\r\n      }\r\n\r\n      setTimeout(() => {\r\n        if (\r\n          (this.type == 4 && this.noWrong == 3) ||\r\n          this.noCorrect == this.nofQuestions\r\n        ) {\r\n          this.reset();\r\n          return;\r\n        }\r\n\r\n        this.updatequestNum(this.getNext());\r\n        this.answered = false;\r\n\r\n        this.$refs[\"ans\" + hisAnswer][0].style.backgroundColor =\r\n          \"var(--ion-color-tertiary)\";\r\n        this.$refs[\"ans\" + correct][0].style.backgroundColor =\r\n          \"var(--ion-color-tertiary)\";\r\n      }, timeout);\r\n    },\r\n\r\n    ansPickedTest(hisAnswer) {\r\n      let picked = this.testAnswers[this._questNum].picked;\r\n      let correct = this.questions[this._questNum].correct;\r\n      let timeout = 700;\r\n      this.answered = true;\r\n\r\n      if (picked == -1) this.numOfAnswered++;\r\n\r\n      this.updatePickedAns({\r\n        _questNum: this._questNum,\r\n        hisAnswer: hisAnswer,\r\n      });\r\n\r\n      if (hisAnswer == correct) {\r\n        if (picked != -1) this.$emit(\"wrong\", -1);\r\n        this.$emit(\"correct\", 1);\r\n      } else {\r\n        if (picked != -1) this.$emit(\"correct\", -1);\r\n        this.$emit(\"wrong\", 1);\r\n      }\r\n\r\n      if (this.numOfAnswered == this.nofQuestions) this.allAnswered = true;\r\n\r\n      setTimeout(() => {\r\n        if (picked == -1) this.updatequestNum(this.getNext());\r\n        this.answered = false;\r\n      }, timeout);\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.ques {\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: top;\r\n  align-items: center;\r\n  padding: 4% 0;\r\n  max-height: 90%;\r\n  margin: 0;\r\n  height: 100%;\r\n}\r\n\r\n.ques-card {\r\n  background-color: var(--ion-white);\r\n  width: 100%;\r\n  height: 10rem;\r\n  border-radius: 2dvh;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 0% 3%;\r\n  transition: all 0.5s ease;\r\n  font-size: 100%;\r\n}\r\n\r\n.line {\r\n  background-color: var(--ion-white);\r\n  width: 95%;\r\n  margin-top: 5%;\r\n  height: 0.3rem;\r\n  border-radius: 2dvh;\r\n}\r\n\r\n.answers {\r\n  display: flex;\r\n  height: 55%;\r\n  flex-direction: column;\r\n  justify-content: flex-start;\r\n  width: 100%;\r\n  margin: 5% 0%;\r\n}\r\n\r\n.ans {\r\n  background: none;\r\n  color: inherit;\r\n  border: none;\r\n  padding: 0;\r\n  font: inherit;\r\n  cursor: pointer;\r\n  outline: inherit;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  background-color: var(--ion-color-tertiary-shade);\r\n  width: 100%;\r\n  padding: 2%;\r\n  border-radius: 3dvh;\r\n  transition: all 0.5s ease;\r\n  font-size: 2.5dvh;\r\n  margin: 2% 0;\r\n}\r\n\r\n.ques-part {\r\n  width: 100%;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n\r\n.transparent {\r\n  opacity: 0;\r\n  transition: all 0.5s ease;\r\n}\r\n\r\n.unpicked {\r\n  background-color: var(--ion-color-tertiary-shade);\r\n}\r\n.picked {\r\n  background-color: var(--ion-color-secondary-shade);\r\n}\r\n.correct {\r\n  background-color: var(--ion-color-success);\r\n}\r\n.wrong {\r\n  background-color: var(--ion-color-danger);\r\n}\r\n</style>"],"mappings":"AA6CA,SAASA,OAAO,EAAEC,SAAQ,QAAS,YAAY;AAC/C,OAAOC,YAAW,MAAO,0BAA0B;AACnD,SAASC,QAAQ,EAAEC,UAAS,QAAS,MAAM;AAE3C,eAAe;EACbC,IAAI,EAAE,iBAAiB;EACvBC,KAAK,EAAE,CAAC,MAAM,EAAE,SAAS,EAAE,OAAO,EAAE,WAAW,EAAE,MAAM,CAAC;EACxDC,UAAU,EAAE;IAAEP,OAAO;IAAEC;EAAU,CAAC;EAElCO,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,EAAE;MACbC,YAAY,EAAE,CAAC;MACfC,QAAQ,EAAE,KAAK;MACfC,WAAW,EAAE,KAAK;MAClBC,aAAa,EAAE;IACjB,CAAC;EACH,CAAC;EAEDC,QAAQ,EAAE;IACR,GAAGX,QAAQ,CAAC,OAAO,EAAE,CAAC,gBAAgB,EAAE,aAAa,EAAE,WAAW,CAAC;EACrE,CAAC;EAED,MAAMY,WAAWA,CAAA,EAAG;IAClB,IAAI,IAAI,CAACC,IAAG,IAAK,CAAC,EAAE;MAClB;MACAd,YAAY,CAACe,OAAO,CAAC,CAACC,IAAI,EAAEC,CAAC,KAAK;QAChCD,IAAI,CAACD,OAAO,CAAEG,IAAI,IAAK;UACrBA,IAAI,CAACT,QAAO,GAAI,KAAK;UACrB,IAAI,IAAI,CAACU,cAAc,CAACC,QAAQ,CAACH,CAAC,CAAC,EAAE;YACnC,IAAI,CAACV,SAAS,CAACc,IAAI,CAAC,IAAI,CAACC,MAAM,CAA