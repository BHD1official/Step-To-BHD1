{"ast":null,"code":"import CountDown from \"./CountDown.vue\";\nimport TriviaInfo from \"./TriviaInfo.vue\";\nimport TriviaQuestions from \"./TriviaQuestions.vue\";\nimport EndGame from \"./EndGame.vue\";\nimport { mapActions } from \"vuex\";\nexport default {\n  name: \"TriviaGame\",\n  components: {\n    CountDown,\n    TriviaInfo,\n    TriviaQuestions,\n    EndGame\n  },\n  props: [\"type\", \"exam\"],\n  data() {\n    return {\n      stage: \"timer\",\n      life: 3,\n      noCorrect: 0,\n      noWrong: 0\n    };\n  },\n  methods: {\n    ...mapActions(\"games\", [\"resetPicked\", \"updatequestNum\"]),\n    endGame() {\n      this.stage = \"end\";\n    },\n    changeCorrect(n) {\n      this.noCorrect += n;\n    },\n    changeWrong(n) {\n      this.noWrong += n;\n    },\n    tryAgain() {\n      if (this.type == 5) this.resetPicked();\n      this.stage = \"game\";\n      this.noCorrect = 0;\n      this.noWrong = 0;\n    },\n    showReview() {\n      this.updatequestNum(0);\n      this.stage = \"review\";\n    }\n  }\n};","map":{"version":3,"names":["CountDown","TriviaInfo","TriviaQuestions","EndGame","mapActions","name","components","props","data","stage","life","noCorrect","noWrong","methods","endGame","changeCorrect","n","changeWrong","tryAgain","type","resetPicked","showReview","updatequestNum"],"sources":["C:\\Users\\User\\Step-To-BHD1\\src\\components\\home\\SubMenu\\SubMenu3\\Games\\Trivia\\TriviaGame.vue"],"sourcesContent":["<template>\r\n  <transition-group tag=\"div\" class=\"trivia\" appear name=\"fadeA\" mode=\"out-in\">\r\n    <count-down\r\n      :key=\"0\"\r\n      @timerEnd=\"this.stage = 'game'\"\r\n      v-if=\"stage == 'timer'\"\r\n    ></count-down>\r\n\r\n    <div class=\"box\" v-else :key=\"1\">\r\n      <trivia-info\r\n        :key=\"0\"\r\n        :type=\"type\"\r\n        :stage=\"stage\"\r\n        :noCorrect=\"noCorrect\"\r\n        :noWrong=\"noWrong\"\r\n        @endGame=\"endGame\"\r\n        :class=\"[stage == 'end' && type != 5 ? 'transparent' : '']\"\r\n      ></trivia-info>\r\n\r\n      <trivia-questions\r\n        :key=\"1\"\r\n        :type=\"type\"\r\n        :noWrong=\"noWrong\"\r\n        :noCorrect=\"noCorrect\"\r\n        :stage=\"stage\"\r\n        :exam=\"exam\"\r\n        @correct=\"changeCorrect\"\r\n        @wrong=\"changeWrong\"\r\n        @endGame=\"endGame\"\r\n        @tryAgain=\"tryAgain\"\r\n        ref=\"child\"\r\n      ></trivia-questions>\r\n\r\n      <end-game\r\n        :key=\"2\"\r\n        :noCorrect=\"noCorrect\"\r\n        :noWrong=\"noWrong\"\r\n        :stage=\"stage\"\r\n        :type=\"type\"\r\n        @tryAgain=\"tryAgain\"\r\n        @showReview=\"showReview\"\r\n      ></end-game>\r\n      \r\n    </div>\r\n  </transition-group>\r\n</template>\r\n\r\n<script>\r\nimport CountDown from \"./CountDown.vue\";\r\nimport TriviaInfo from \"./TriviaInfo.vue\";\r\nimport TriviaQuestions from \"./TriviaQuestions.vue\";\r\nimport EndGame from \"./EndGame.vue\";\r\nimport {mapActions } from \"vuex\";\r\n\r\nexport default {\r\n  name: \"TriviaGame\",\r\n  components: { CountDown, TriviaInfo, TriviaQuestions, EndGame },\r\n  props: [\"type\", \"exam\"],\r\n\r\n  data() {\r\n    return {\r\n      stage: \"timer\",\r\n      life: 3,\r\n      noCorrect: 0,\r\n      noWrong: 0,\r\n    };\r\n  },\r\n\r\n  methods: {\r\n    ...mapActions(\"games\", [\"resetPicked\", \"updatequestNum\"]),\r\n\r\n    endGame() {\r\n      this.stage = \"end\";\r\n    },\r\n\r\n    changeCorrect(n) {\r\n      this.noCorrect += n;\r\n    },\r\n\r\n    changeWrong(n) {\r\n      this.noWrong += n;\r\n    },\r\n\r\n    tryAgain() {\r\n      if (this.type == 5) this.resetPicked();\r\n      this.stage = \"game\";\r\n      this.noCorrect = 0;\r\n      this.noWrong = 0;\r\n    },\r\n\r\n    showReview() {\r\n      this.updatequestNum(0)\r\n      this.stage = \"review\";\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.trivia {\r\n  height: 90dvh;\r\n  display: flex;\r\n  align-items: space-between;\r\n  flex-direction: column;\r\n  padding: 1% 4% ;\r\n}\r\n\r\n.box {\r\n  height: 100%;\r\n  width: 100%;\r\n}\r\n\r\n.trivia-icon {\r\n  display: inline-block;\r\n  width: 10%;\r\n  height: 10%;\r\n}\r\n\r\n.transparent {\r\n  opacity: 0;\r\n  transition: all 0.5s ease;\r\n}\r\n\r\n@media only screen and (max-height: 800px) {\r\n  .trivia {\r\n    padding: 4%, 1%;\r\n  }\r\n}\r\n</style>\r\n"],"mappings":"AAgDA,OAAOA,SAAQ,MAAO,iBAAiB;AACvC,OAAOC,UAAS,MAAO,kBAAkB;AACzC,OAAOC,eAAc,MAAO,uBAAuB;AACnD,OAAOC,OAAM,MAAO,eAAe;AACnC,SAAQC,UAAS,QAAS,MAAM;AAEhC,eAAe;EACbC,IAAI,EAAE,YAAY;EAClBC,UAAU,EAAE;IAAEN,SAAS;IAAEC,UAAU;IAAEC,eAAe;IAAEC;EAAQ,CAAC;EAC/DI,KAAK,EAAE,CAAC,MAAM,EAAE,MAAM,CAAC;EAEvBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,OAAO;MACdC,IAAI,EAAE,CAAC;MACPC,SAAS,EAAE,CAAC;MACZC,OAAO,EAAE;IACX,CAAC;EACH,CAAC;EAEDC,OAAO,EAAE;IACP,GAAGT,UAAU,CAAC,OAAO,EAAE,CAAC,aAAa,EAAE,gBAAgB,CAAC,CAAC;IAEzDU,OAAOA,CAAA,EAAG;MACR,IAAI,CAACL,KAAI,GAAI,KAAK;IACpB,CAAC;IAEDM,aAAaA,CAACC,CAAC,EAAE;MACf,IAAI,CAACL,SAAQ,IAAKK,CAAC;IACrB,CAAC;IAEDC,WAAWA,CAACD,CAAC,EAAE;MACb,IAAI,CAACJ,OAAM,IAAKI,CAAC;IACnB,CAAC;IAEDE,QAAQA,CAAA,EAAG;MACT,IAAI,IAAI,CAACC,IAAG,IAAK,CAAC,EAAE,IAAI,CAACC,WAAW,CAAC,CAAC;MACtC,IAAI,CAACX,KAAI,GAAI,MAAM;MACnB,IAAI,CAACE,SAAQ,GAAI,CAAC;MAClB,IAAI,CAACC,OAAM,GAAI,CAAC;IAClB,CAAC;IAEDS,UAAUA,CAAA,EAAG;MACX,IAAI,CAACC,cAAc,CAAC,CAAC;MACrB,IAAI,CAACb,KAAI,GAAI,QAAQ;IACvB;EACF;AACF,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}