{"ast":null,"code":"import ChoseChaptesCircels from \"@/components/reuse/ChoseChaptesCircels.vue\";\nimport CardWithLine from \"@/components/reuse/CardWithLine.vue\";\nimport gamesInfo from \"@/json/games/gamesInfo.json\";\nimport ChapterInfo from \"@/json/chapters/ChapterInfo\";\nimport { mapState, mapMutations, mapActions } from \"vuex\";\nexport default {\n  name: \"SubMenu3\",\n  components: {\n    ChoseChaptesCircels,\n    CardWithLine\n  },\n  data() {\n    return {\n      slidesNum: null,\n      gamesInfo: gamesInfo,\n      ChapterInfo: ChapterInfo,\n      circlesInfo: [],\n      noChapters: 10,\n      allChosen: false\n    };\n  },\n  computed: {\n    ...mapState(\"returning\", [\"backToSubMenu3\"]),\n    ...mapState(\"games\", [\"gameType\", \"chosenChapters\"])\n  },\n  created() {\n    for (let i = 0; i < this.noChapters; i++) this.circlesInfo[i] = this.ChapterInfo[i].title;\n  },\n  methods: {\n    ...mapMutations(\"navigation\", [\"hideNavi\", \"toggleMiniIcon\"]),\n    ...mapActions(\"games\", [\"setGameType\", \"addOrRemoveChap\"]),\n    ...mapActions(\"returning\", [\"setReturningFunc\"]),\n    circlesChosen(listOfCircles, noChap, explanation) {\n      this.addOrRemoveChap(noChap);\n      console.log(explanation);\n    },\n    chooseAll() {\n      for (let chapterNum = 0; chapterNum < 11; chapterNum++) {\n        this.addOrRemoveChap(chapterNum);\n        this.allChosen = true;\n        this.opacity = 1;\n      }\n    }\n  }\n};","map":{"version":3,"names":["ChoseChaptesCircels","CardWithLine","gamesInfo","ChapterInfo","mapState","mapMutations","mapActions","name","components","data","slidesNum","circlesInfo","noChapters","allChosen","computed","created","i","title","methods","circlesChosen","listOfCircles","noChap","explanation","addOrRemoveChap","console","log","chooseAll","chapterNum","opacity"],"sources":["C:\\Users\\User\\Step-To-BHD1\\src\\components\\home\\SubMenu\\SubMenu1\\SubMenu1.vue"],"sourcesContent":["<template>\r\n  <card-with-line tit