],\r\n      noChapters: 10,\r\n      allChosen: false,\r\n    };\r\n  },\r\n\r\n  computed: {\r\n    ...mapState(\"returning\", [\"backToSubMenu1\"]),\r\n    ...mapState(\"games\", [\"gameType\", \"chosenChapters\"]),\r\n  },\r\n\r\n  created() {\r\n    for (let i = 0; i < this.noChapters; i++)\r\n      this.circlesInfo[i] = this.ChapterInfo[i].title;\r\n  },\r\n\r\n  methods: {\r\n    ...mapMutations(\"navigation\", [\"hideNavi\", \"toggleMiniIcon\"]),\r\n    ...mapActions(\"games\", [\"setGameType\", \"addOrRemoveChap\"]),\r\n    ...mapActions(\"returning\", [\"setReturningFunc\"]),\r\n\r\n    choseGame(noGame) {\r\n      if (this.chosenChapters.length == 0) {\r\n        return;\r\n      }\r\n\r\n      setTimeout(() => {\r\n        this.toggleMiniIcon();\r\n      }, 500);\r\n\r\n      this.setReturningFunc(2);\r\n      this.setGameType(noGame);\r\n      this.hideNavi();\r\n    },\r\n\r\n    circlesChosen(listOfCircles, noChap, explanation) {\r\n      this.addOrRemoveChap(noChap);\r\n      console.log(explanation);\r\n    },\r\n\r\n    chooseAll() {\r\n      for (let chapterNum = 0; chapterNum < 11; chapterNum++) {\r\n        this.addOrRemoveChap(chapterNum);\r\n        this.allChosen = true;\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.games > * {\r\n  transition: opacity 0.2s linear;\r\n}\r\n\r\n.circle {\r\n  position: relative;\r\n  top: -5dvh;\r\n  background-color: var(--ion-color-secondary-tint);\r\n  height: 10dvh;\r\n  width: 10dvh;\r\n  border-radius: 100%;\r\n  display: flex;\r\n  align-items: flex-end;\r\n  justify-content: center;\r\n  padding-bottom: 1dvh;\r\n  font-size: 3.5dvh;\r\n  font-weight: 700;\r\n  color: var(--ion-color-medium);\r\n  text-shadow: none;\r\n}\r\n.game-icon {\r\n  width: 7dvh;\r\n  height: 7dvh;\r\n}\r\n\r\n.chooseAll {\r\n  background: var(--ion-color-primary-tint-light);\r\n  height: 5dvh;\r\n  width: 10dvh;\r\n  margin: 1%;\r\n  border-radius: 45%;\r\n  display: flex;\r\n  align-items: center;\r\