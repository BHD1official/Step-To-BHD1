{"ast":null,"code":"import ChoseChaptesCircels from \"@/components/reuse/ChoseChaptesCircels.vue\";\nimport CardWithLine from \"@/components/reuse/CardWithLine.vue\";\nimport TriviaGame from \"./Games/Trivia/TriviaGame.vue\";\nimport gamesInfo from \"@/json/games/gamesInfo.json\";\nimport ChapterInfo from \"@/json/chapters/ChapterInfo\";\nimport { IonButton } from \"@ionic/vue\";\nimport { mapState, mapMutations, mapActions } from \"vuex\";\nexport default {\n  name: \"SubMenu1\",\n  components: {\n    ChoseChaptesCircels,\n    CardWithLine,\n    TriviaGame,\n    IonButton\n  },\n  data() {\n    return {\n      slidesNum: null,\n      gamesInfo: gamesInfo,\n      ChapterInfo: ChapterInfo,\n      circlesInfo: [],\n      noChapters: 10,\n      allChosen: false\n    };\n  },\n  computed: {\n    ...mapState(\"returning\", [\"backToSubMenu1\"]),\n    ...mapState(\"games\", [\"gameType\", \"chosenChapters\"])\n  },\n  created() {\n    for (let i = 0; i < this.noChapters; i++) this.circlesInfo[i] = this.ChapterInfo[i].title;\n  },\n  methods: {\n    ...mapMutations(\"navigation\", [\"hideNavi\", \"toggleMiniIcon\"]),\n    ...mapActions(\"games\", [\"setGameType\", \"addOrRemoveChap\"]),\n    ...mapActions(\"returning\", [\"setReturningFunc\"]),\n    choseGame(noGame) {\n      if (this.chosenChapters.length == 0) {\n        return;\n      }\n      setTimeout(() => {\n        this.toggleMiniIcon();\n      }, 500);\n      this.setReturningFunc(2);\n      this.setGameType(noGame);\n      this.hideNavi();\n    },\n    circlesChosen(listOfCircles, noChap, explanation) {\n      this.addOrRemoveChap(noChap);\n      console.log(explanation);\n    },\n    chooseAll() {\n      for (let chapterNum = 0; chapterNum < 11; chapterNum++) {\n        this.addOrRemoveChap(chapterNum);\n        this.allChosen = true;\n      }\n    }\n  }\n};","map":{"version":3,"names":["ChoseChaptesCircels","CardWithLine","TriviaGame","gamesInfo","ChapterInfo","IonButton","mapState","mapMutations","mapActions