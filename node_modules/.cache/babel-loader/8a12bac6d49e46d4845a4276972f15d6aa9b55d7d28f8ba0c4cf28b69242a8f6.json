{"ast":null,"code":"import { IonImg, IonText } from \"@ionic/vue\";\nimport { mapState, mapActions } from \"vuex\";\nexport default {\n  name: \"TriviaInfo\",\n  components: {\n    IonImg,\n    IonText\n  },\n  props: [\"type\", \"noCorrect\", \"noWrong\", \"stage\"],\n  data() {\n    return {\n      life: 3,\n      min: 1,\n      sec: 0,\n      isPicked: false,\n      timeout: null,\n      isDark: false\n    };\n  },\n  computed: {\n    ...mapState(\"games\", [\"testAnswers\", \"_questNum\"])\n  },\n  mounted() {\n    this.isDark = document.body.classList.contains(\"dark\");\n  },\n  methods: {\n    ...mapActions(\"games\", [\"updatequestNum\"]),\n    countDownTimer() {\n      if (this.min == 0 && this.sec == 0) {\n        this.$emit(\"endGame\");\n        return;\n      }\n      this.timeout = setTimeout(() => {\n        if (this.sec > 0) this.sec--;else {\n          this.min--;\n          this.sec = 59;\n        }\n        this.countDownTimer();\n      }, 1000);\n    },\n    changeQuest(n) {\n      this.updatequestNum(n - 1);\n    },\n    circleClass(n) {\n      if (!this.testAnswers || !this.testAnswers[n - 1]) return \"\";\n      if (this.stage == \"game\") {\n        return this.testAnswers[n - 1].picked == -1 ? \"\" : \"answered\";\n      } else {\n        return this.testAnswers[n - 1].correct == this.testAnswers[n - 1].picked ? \"correct\" : \"wronge\";\n      }\n    }\n  },\n  watch: {\n    stage: {\n      immediate: true,\n      handler() {\n        if (this.stage == \"game\") {\n          if (this.type == 2) {\n            this.min = 1;\n            this.sec = 0;\n            this.countDownTimer();\n          } else if (this.type == 3) {\n            // טיימר 10 דקות למבחן\n\n            this.min = 10;\n            this.sec = 0;\n            this.countDownTimer();\n          }\n        } else if (this.stage == \"end\") {\n          clearTimeout(this.timeout);\n        }\n      }\n    }\n  }\n};","map":{"version":3,"names":["IonImg","IonText","mapState","mapActions","name","components","props","data","life","min","sec","isPicked","timeout","isDark","computed","mounted","document","body","classList","contains","methods","countDownTimer","$emit","setTimeout","changeQuest","n","updatequestNum","circleClass","testAnswers","stage","picked","correct","watch","immediate","handler","type","clearTimeout"],"sources":["C:\\Users\\User\\Step-To-BHD1\\src\\components\\home\\SubMenu\\SubMenu3\\Games\\Trivia\\TriviaInfo.vue"],"sourcesContent":["<template>\r\n\r\n  <div :class=\"[type == 3 ? 'info-test' : '', 'info']\">\r\n\r\n    <div\r\n\r\n      v-if=\"type == 2 || type == 3\"\r\n\r\n      :class=\"[\r\n\r\n        type == 3 ? 'clock-part-test' : '',\r\n\r\n        stage == 'end' ? 'transparent' : '',\r\n\r\n        'clock-part',\r\n\r\n      ]\"\r\n\r\n    >\r\n\r\n      <ion-img\r\n\r\n        :class=\"[\r\n\r\n          type == 3 ? 'clock-icn-test' : '',\r\n\r\n          isDark ? 'dark' : '',\r\n\r\n          'trivia-icon clock-icn',\r\n\r\n        ]\"\r\n\r\n        :src=\"require(`@/assets/media1/HomePage/games/trivia/time.png`)\"\r\n\r\n      ></ion-img>\r\n\r\n\r\n\r\n      <div class=\"time\">\r\n\r\n        <div class=\"text-dark-plain\" v-if=\"sec > 9\">\r\n\r\n          {{ min + \":\" + sec }}\r\n\r\n        </div>\r\n\r\n        <div class=\"text-dark-plain\" v-else>\r\n\r\n          {{ min + \":0\" + sec }}\r\n\r\n        </div>\r\n\r\n      </div>\r\n\r\n    </div>\r\n\r\n\r\n\r\n    <div class=\"hearts\" v-else-if=\"type == 4\">\r\n\r\n      <ion-img\r\n\r\n        v-for=\"n in life\"\r\n\r\n        :key=\"n\"\r\n\r\n        :class=\"[\r\n\r\n          n > noWrong ? 'popIn' : 'popOut',\r\n\r\n          isDark ? 'dark' : '',\r\n\r\n          'trivia-icon heart',\r\n\r\n        ]\"\r\n\r\n        :src=\"require(`@/assets/media1/HomePage/games/trivia/like.png`)\"\r\n\r\n      ></ion-img>\r\n\r\n    </div>\r\n\r\n\r\n\r\n    <!-- הצגת עיגולי המבחן עבור type == 3 -->\r\n\r\n    <div class=\"test\" v-if=\"type == 3\">\r\n\r\n      <button\r\n\r\n        v-for=\"n in 10\"\r\n\r\n        :key=\"n\"\r\n\r\n        :class=\"['circle', circleClass(n)]\"\r\n\r\n        @click=\"changeQuest(n)\"\r\n\r\n      >\r\n\r\n        {{ n }}\r\n\r\n      </button>\r\n\r\n    </div>\r\n\r\n\r\n\r\n    <div class=\"checkd-part\" v-if=\"type == 2\">\r\n\r\n      <ion-img\r\n\r\n        :class=\"[isDark ? 'dark' : '', 'trivia-icon mark']\"\r\n\r\n        :src=\"require(`@/assets/media1/HomePage/games/trivia/check.png`)\"\r\n\r\n      ></ion-img>\r\n\r\n      <ion-text class=\"text-dark-plain checked-num\"> {{ noCorrect }}</ion-text>\r\n\r\n    </div>\r\n\r\n  </div>\r\n\r\n</template>\r\n\r\n\r\n\r\n<script>\r\n\r\nimport { IonImg, IonText } from \"@ionic/vue\";\r\n\r\nimport { mapState, mapActions } from \"vuex\";\r\n\r\n\r\n\r\nexport default {\r\n\r\n  name: \"TriviaInfo\",\r\n\r\n  components: { IonImg, IonText },\r\n\r\n  props: [\"type\", \"noCorrect\", \"noWrong\", \"stage\"],\r\n\r\n\r\n\r\n  data() {\r\n\r\n    return {\r\n\r\n      life: 3,\r\n\r\n      min: 1,\r\n\r\n      sec: 0,\r\n\r\n      isPicked: false,\r\n\r\n      timeout: null,\r\n\r\n      isDark: false,\r\n\r\n    };\r\n\r\n  },\r\n\r\n\r\n\r\n  computed: {\r\n\r\n    ...mapState(\"games\", [\"testAnswers\", \"_questNum\"]),\r\n\r\n  },\r\n\r\n\r\n\r\n  mounted() {\r\n\r\n    this.isDark = document.body.classList.contains(\"dark\");\r\n\r\n  },\r\n\r\n\r\n\r\n  methods: {\r\n\r\n    ...mapActions(\"games\", [\"updatequestNum\"]),\r\n\r\n\r\n\r\n    countDownTimer() {\r\n\r\n      if (this.min == 0 && this.sec == 0) {\r\n\r\n        this.$emit(\"endGame\");\r\n\r\n        return;\r\n\r\n      }\r\n\r\n\r\n\r\n      this.timeout = setTimeout(() => {\r\n\r\n        if (this.sec > 0) this.sec--;\r\n\r\n        else {\r\n\r\n          this.min--;\r\n\r\n          this.sec = 59;\r\n\r\n        }\r\n\r\n        this.countDownTimer();\r\n\r\n      }, 1000);\r\n\r\n    },\r\n\r\n\r\n\r\n    changeQuest(n) {\r\n\r\n      this.updatequestNum(n - 1);\r\n\r\n    },\r\n\r\n\r\n\r\n    circleClass(n) {\r\n\r\n      if (!this.testAnswers || !this.testAnswers[n - 1]) return \"\";\r\n\r\n\r\n\r\n      if (this.stage == \"game\") {\r\n\r\n        return this.testAnswers[n - 1].picked == -1 ? \"\" : \"answered\";\r\n\r\n      } else {\r\n\r\n        return this.testAnswers[n - 1].correct == this.testAnswers[n - 1].picked\r\n\r\n          ? \"correct\"\r\n\r\n          : \"wronge\";\r\n\r\n      }\r\n\r\n    },\r\n\r\n  },\r\n\r\n\r\n\r\n  watch: {\r\n\r\n    stage: {\r\n\r\n      immediate: true,\r\n\r\n      handler() {\r\n\r\n        if (this.stage == \"game\") {\r\n\r\n          if (this.type == 2) {\r\n\r\n            this.min = 1;\r\n\r\n            this.sec = 0;\r\n\r\n            this.countDownTimer();\r\n\r\n          } else if (this.type == 3) {\r\n\r\n            // טיימר 10 דקות למבחן\r\n\r\n            this.min = 10;\r\n\r\n            this.sec = 0;\r\n\r\n            this.countDownTimer();\r\n\r\n          }\r\n\r\n        } else if (this.stage == \"end\") {\r\n\r\n          clearTimeout(this.timeout);\r\n\r\n        }\r\n\r\n      },\r\n\r\n    },\r\n\r\n  },\r\n\r\n};\r\n\r\n</script>\r\n\r\n\r\n\r\n<style scoped>\r\n\r\n.info {\r\n\r\n  width: 100%;\r\n\r\n  display: flex;\r\n\r\n  justify-content: space-between;\r\n\r\n  align-items: center;\r\n\r\n}\r\n\r\n\r\n\r\n.info-test {\r\n\r\n  flex-direction: column;\r\n\r\n}\r\n\r\n\r\n\r\n.time {\r\n\r\n  font-size: 3dvh;\r\n\r\n}\r\n\r\n\r\n\r\n.trivia-icon {\r\n\r\n  display: inline-block;\r\n\r\n  width: 30%;\r\n\r\n  height: 30%;\r\n\r\n}\r\n\r\n\r\n\r\n.hearts,\r\n\r\n.clock-part {\r\n\r\n  width: 50%;\r\n\r\n  display: flex;\r\n\r\n}\r\n\r\n\r\n\r\n.hearts {\r\n\r\n  flex-direction: row-reverse;\r\n\r\n  justify-content: flex-end;\r\n\r\n}\r\n\r\n\r\n\r\n.clock-part-test {\r\n\r\n  width: 100%;\r\n\r\n  height: 40%;\r\n\r\n  margin-bottom: 1%;\r\n\r\n  align-items: baseline;\r\n\r\n}\r\n\r\n.heart {\r\n\r\n  margin: 2%;\r\n\r\n  width: 15%;\r\n\r\n  position: relative;\r\n\r\n  right: 0;\r\n\r\n}\r\n\r\n.checkd-part {\r\n\r\n  width: 50%;\r\n\r\n  display: flex;\r\n\r\n  justify-content: flex-end;\r\n\r\n  align-items: center;\r\n\r\n}\r\n\r\n\r\n\r\n.mark {\r\n\r\n  margin: 2%;\r\n\r\n  width: 15%;\r\n\r\n  position: relative;\r\n\r\n  right: 0;\r\n\r\n}\r\n\r\n\r\n\r\n.checked-num {\r\n\r\n  margin: 0 4% 0 4%;\r\n\r\n  font-size: 3dvh;\r\n\r\n}\r\n\r\n\r\n\r\n.clock-icn {\r\n\r\n  margin: 2%;\r\n\r\n  margin-left: 5%;\r\n\r\n  width: 15%;\r\n\r\n  height: 100%;\r\n\r\n  position: relative;\r\n\r\n  right: 0;\r\n\r\n}\r\n\r\n\r\n\r\n.clock-icn-test {\r\n\r\n  margin: 0%;\r\n\r\n  height: 1.5rem;\r\n\r\n  width: 10%;\r\n\r\n  align-content: start;\r\n\r\n  padding: 0;\r\n\r\n  --padding: 0;\r\n\r\n  margin-left: 2%;\r\n\r\n  transform: translateY(15%);\r\n\r\n}\r\n\r\n.test {\r\n\r\n  margin: 1% 0;\r\n\r\n  justify-content: space-between;\r\n\r\n  display: grid;\r\n\r\n  width: 100%;\r\n\r\n  height: fit-content;\r\n\r\n  padding: 0;\r\n\r\n  align-self: center;\r\n\r\n  grid-template-columns: auto auto auto auto auto auto auto auto auto auto auto;\r\n\r\n  row-gap: 0;\r\n\r\n  column-gap: 0;\r\n\r\n  align-items: center;\r\n\r\n  justify-items: center;\r\n\r\n}\r\n\r\n\r\n\r\n.circle {\r\n\r\n  min-width: 0px;\r\n\r\n  border-radius: 100%;\r\n\r\n  margin: 0;\r\n\r\n  background: var(--ion-color-primary-tint-light);\r\n\r\n  color: var(--ion-color-medium);\r\n\r\n  font-weight: 700;\r\n\r\n  width: 4dvh;\r\n\r\n  height: 4dvh;\r\n\r\n  aspect-ratio: 1/1;\r\n\r\n  align-items: center;\r\n\r\n  appearance: none;\r\n\r\n  cursor: pointer;\r\n\r\n  display: inline-flex;\r\n\r\n  fill: currentcolor;\r\n\r\n  justify-content: center;\r\n\r\n  letter-spacing: 0.25px;\r\n\r\n  line-height: normal;\r\n\r\n  max-width: 100%;\r\n\r\n  overflow: visible;\r\n\r\n  position: relative;\r\n\r\n  text-align: center;\r\n\r\n  text-transform: none;\r\n\r\n  transition: box-shadow 280ms cubic-bezier(0.4, 0, 0.2, 1),\r\n\r\n    opacity 15ms linear 30ms, transform 270ms cubic-bezier(0, 0, 0.2, 1) 0ms;\r\n\r\n  user-select: none;\r\n\r\n  -webkit-user-select: none;\r\n\r\n  touch-action: manipulation;\r\n\r\n  will-change: transform, opacity;\r\n\r\n  z-index: 0;\r\n\r\n}\r\n\r\n\r\n\r\n.circle:active {\r\n\r\n  outline: none;\r\n\r\n}\r\n\r\n\r\n\r\n.answered {\r\n\r\n  transition: all 1s ease;\r\n\r\n  color: var(--ion-color-secondary);\r\n\r\n  background: var(--ion-color-primary);\r\n\r\n}\r\n\r\n\r\n\r\n.transparent {\r\n\r\n  opacity: 0;\r\n\r\n  transition: all 0.5s ease;\r\n\r\n}\r\n\r\n\r\n\r\n.dark {\r\n\r\n  filter: sepia(900%) contrast(100%) brightness(400%);\r\n\r\n}\r\n\r\n\r\n\r\n@media only screen and (min-height: 1000px) {\r\n\r\n  .circle {\r\n\r\n    width: 3em;\r\n\r\n    height: 3em;\r\n\r\n  }\r\n\r\n}\r\n\r\n\r\n\r\n@media only screen and (min-height: 800px) {\r\n\r\n  .time {\r\n\r\n    font-size: 120%;\r\n\r\n  }\r\n\r\n\r\n\r\n  .test {\r\n\r\n    height: 15%;\r\n\r\n  }\r\n\r\n}\r\n\r\n\r\n\r\n.correct {\r\n\r\n  background: var(--ion-color-success) !important;\r\n\r\n}\r\n\r\n.wronge {\r\n\r\n  background: var(--ion-color-danger) !important;\r\n\r\n  animation: wrong-pop infinite 1.5s;\r\n\r\n}\r\n\r\n\r\n\r\n@keyframes wrong-pop {\r\n\r\n  0% {\r\n\r\n    box-shadow: none;\r\n\r\n  }\r\n\r\n  50% {\r\n\r\n    box-shadow: 0px 0px 0.7rem 0px var(--ion-color-danger);\r\n\r\n  }\r\n\r\n  100% {\r\n\r\n    box-shadow: none;\r\n\r\n  }\r\n\r\n}\r\n\r\n</style> שהטריוייה אינפו זה ככה - זה עובד טוב -\r\n\r\n"],"mappings":"AAkIA,SAASA,MAAM,EAAEC,OAAM,QAAS,YAAY;AAE5C,SAASC,QAAQ,EAAEC,UAAS,QAAS,MAAM;AAI3C,eAAe;EAEbC,IAAI,EAAE,YAAY;EAElBC,UAAU,EAAE;IAAEL,MAAM;IAAEC;EAAQ,CAAC;EAE/BK,KAAK,EAAE,CAAC,MAAM,EAAE,WAAW,EAAE,SAAS,EAAE,OAAO,CAAC;EAIhDC,IAAIA,CAAA,EAAG;IAEL,OAAO;MAELC,IAAI,EAAE,CAAC;MAEPC,GAAG,EAAE,CAAC;MAENC,GAAG,EAAE,CAAC;MAENC,QAAQ,EAAE,KAAK;MAEfC,OAAO,EAAE,IAAI;MAEbC,MAAM,EAAE;IAEV,CAAC;EAEH,CAAC;EAIDC,QAAQ,EAAE;IAER,GAAGZ,QAAQ,CAAC,OAAO,EAAE,CAAC,aAAa,EAAE